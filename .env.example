# ============================================
# SMS Reader — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# API Key — used by the Android app to authenticate with this server
# Generate one with: openssl rand -hex 32
API_KEY=your-api-key-here

# Dashboard login password
DASHBOARD_PASSWORD=your-dashboard-password

# Session secret for cookie signing
# Generate one with: openssl rand -hex 32
SESSION_SECRET=your-session-secret-here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Your Telegram Chat ID (from /getUpdates)
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Server port (Render sets this automatically)
PORT=3000

# Message expiry time in minutes (default: 60)
MESSAGE_EXPIRY_MINUTES=60
